{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "code-review-graph *": "allow",
      "logscope-triage *": "allow",
      "uv tool install *": "allow",
      "uv tool upgrade *": "allow",
      "uvx code-review-graph *": "allow"
    }
  },
  "mcp": {
    "crg": {
      "type": "local",
      "command": ["uvx", "code-review-graph", "mcp"],
      "enabled": true
    }
  }
}
